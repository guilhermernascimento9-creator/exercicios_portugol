programa {
  funcao inicio() {
    inteiro idade
    escreva("Digite a sua idade: ")
    leia(idade)
    cadeia gravida
    escreva("Você está grávida? S/N: ")
    leia(gravida)

    se (idade >= 65 ou gravida =="S" ){
      escreva("Vá para a fila presencial.")}

    senao {
      escreva("Vá para a fila normal")
    }
    

    }



  }
}
